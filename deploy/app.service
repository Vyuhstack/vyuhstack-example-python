# /etc/systemd/system/app.service
[Unit]
Description=VyuhStack example (Python FastAPI)
After=network.target

[Service]
User=vyuh-user
WorkingDirectory=/opt/app
ExecStart=/opt/app/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=on-failure

[Install]
WantedBy=multi-user.target
